{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["worker", "src/engine", "src/bots", "src/game/runner.ts", "src/online/protocol.ts"],
  "exclude": ["src/**/*.test.ts"]
}
