{
  // Cloudflare configuration: one Worker serves the website and the online game rooms.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pedro",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Room connections must reach the Worker, never the static files.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "PedroRoom" },
      { "name": "LOBBY", "class_name": "PedroLobby" }
    ]
  },
  // SQLite-backed Durable Objects are the ones included in the free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PedroRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["PedroLobby"] }
  ],
  "observability": { "enabled": true }
}
